{
    "header": {
        "enabled": true,
        "style": "default",
        "title": "$sitename!"
    },
    "footer": {
        "enabled": true,
        "wm": "$sitename"
    },
    "content": [
        {
            "type": "block",
            "title": "Hey!",
            "text": "$1, $2! Welcome to $sitename",
            "styles": ["background-color: green; font-size: xx-small;"]
        },
        {
            "type": "title_text_box",
            "title": "$sitename title text box",
            "text": "Hello! I am a wild text box. The website I am in is called $sitename. Such a lovely name, isn't it?\r\nAnyway, what brings you here?"
        },
        {
            "type": "text_box",
            "text": "Hello! I am a wild text box. The website I am in is called $sitename. Such a lovely name, isn't it?\r\nAnyway, what brings you here?"
        },
        {
            "type": "line"
        },
        {
            "type": "divider",
            "invert": true
        },
        {
            "type": "divider"
        },
        {
            "type": "skippable block"
        },
        {
            "type": "block_button",
            "title": "$1",
            "text": "$sitename traveler",
            "button": {
                "target": "",
                "text": "Travel somewhere"
            }
        }
    ],
    "data": {
    },
    "metadata": [
        {
            "type": "title",
            "content": "Home - $sitename"
        }
    ]
}